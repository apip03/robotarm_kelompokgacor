<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="robotic_arm_pjbl">
  <xacro:arg name="use_sim" default="false"/>
  <xacro:arg name="controllers_file" default=""/>

  <xacro:include filename="$(find robotic_arm_pjbl_description)/urdf/robot_body.urdf"/>
  <xacro:include filename="$(find robotic_arm_pjbl_description)/urdf/ros2_control.xacro"/>

  <link name="world"/>
  <joint name="world_fixed" type="fixed">
    <parent link="world"/><child link="base_link"/>
  </joint>

  <xacro:arm_ros2_control use_sim="$(arg use_sim)" controllers_file="$(arg controllers_file)"/>
</robot>
